{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@klyp/shared": ["../../packages/shared/src/index.ts"],
      "@klyp/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
